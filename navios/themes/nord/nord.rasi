/**
 * Nord Rofi Theme
 * Based on the Nord color palette: https://www.nordtheme.com/
 */

* {
    nord0: #2E3440;   /* dark background */
    nord1: #3B4252;
    nord2: #434C5E;
    nord3: #4C566A;
    nord4: #D8DEE9;   /* light fg */
    nord5: #E5E9F0;
    nord6: #ECEFF4;
    nord7: #8FBCBB;   /* cyan */
    nord8: #88C0D0;   /* light cyan */
    nord9: #81A1C1;   /* blue */
    nord10: #5E81AC;  /* darker blue */
    nord11: #BF616A;  /* red */
    nord12: #D08770;  /* orange */
    nord13: #EBCB8B;  /* yellow */
    nord14: #A3BE8C;  /* green */
    nord15: #B48EAD;  /* purple */
    nordextra: #1C1E26;

    background:                  @nordextra;
    background-color:            @background;
    foreground:                  @nord8;
    selected-normal-foreground:  @nord13;
    selected-normal-background:  @nord8;
    normal-foreground:           @foreground;
    normal-background:           @background;
    border-color:                @nord3;
    separatorcolor:              @nord3;
}

window {
    background-color: @background;
    border:           2;
    border-color: @nord1;
    padding:          5;
    border-radius: 2px;
    width: 700;
}

mainbox {
    border:  0;
    padding: 0;
}

message {
    border-color: @separatorcolor;
    padding:      0px;
}

textbox {
    text-color: @foreground;
    border-color: @separatorcolor;
}

listview {
    columns: 1;
    fixed-height: 5;
    border-color: @separatorcolor;
    spacing:      7px;
    scrollbar:    true;
}

element {
    padding: 2px;
    margin: 0px;
}

element.normal.normal {
    text-color: @nord4;          /* bright white text for unselected entries */
}

element.selected.normal {
    text-color: @nord9;          /* dark text on cyan selection */
}

element.alternate.normal {
    text-color: @nord4;          /* bright white for alternate rows */
}

element.normal.active {
    text-color: @nord10;          /* bright white for alternate rows */
}

element.selected.active {
    text-color: @nord9;          /* bright white for alternate rows */
}

element.alternate.active {
    text-color: @nord9;          /* bright white for alternate rows */
}

element-text {
    text-color: inherit;          /* keep inherit, so our element overrides propagate */
}


scrollbar {
    width:        4px;
    border:       0;
    handle-width: 8px;
    padding:      0;
}

inputbar {
    spacing:    0;
    text-color: @normal-foreground;
    padding:    2px;
    children:   [ prompt, textbox-prompt-colon, entry, case-indicator ];
}

prompt {
    spacing:    0;
    text-color: @normal-foreground;
}

entry {
    spacing:    0;
    text-color: @normal-foreground;
}

textbox-prompt-colon {
    expand:     false;
    margin:     0px 0.3em 0em 0em;
    text-color: @normal-foreground;
}

